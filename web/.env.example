# Conexão do Neon (Vercel > Storage > Neon cria automaticamente)
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo para assinar a sessão de login (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Código exigido UMA vez para criar o acesso em /setup (impede que outra pessoa crie a conta antes)
SETUP_CODE=

# Token compartilhado com o robô local (mesmo valor no .env do robô)
ROBO_TOKEN=
